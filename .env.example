# Copy this file to .env and fill in real values before deploying.
#   cp .env.example .env
# .env is gitignored — your real password and session secret never get
# committed to the repository.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=generate-a-long-random-secret
PORT=3000
COOKIE_SECURE=false

# The port docker-compose exposes on the host machine (the container always
# listens on 3000 internally regardless of this value).
HOST_PORT=8080

# Generate a strong SESSION_SECRET with:
#   openssl rand -hex 32
# Required to be at least 32 characters when NODE_ENV=production — the app
# will refuse to start otherwise.
